# Copy this file to .streamlit/secrets.toml and fill in your values.
# secrets.toml is git-ignored — never commit the real token.
#
# Choose ONE of the two formats below.

# ── Format A: flat keys ────────────────────────────────────────────────────────
GITHUB_TOKEN    = "ghp_YOUR_TOKEN_HERE"
GITHUB_REPO     = "ObenajM/proyecto-arboles-agentic"
GITHUB_BRANCH   = "main"
GITHUB_CSV_PATH = "data/arboles_mapeados.csv"

# ── Format B: nested [github] section ─────────────────────────────────────────
# [github]
# token    = "ghp_YOUR_TOKEN_HERE"
# repo     = "ObenajM/proyecto-arboles-agentic"
# branch   = "main"
# csv_path = "data/arboles_mapeados.csv"

# Token needs: repo scope  (or Contents: write for fine-grained tokens)
# Create one at: https://github.com/settings/tokens
